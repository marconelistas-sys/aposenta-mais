diff --git a/src/styles/refresh.css b/src/styles/refresh.css
new file mode 100644
index 0000000..20bf230
--- /dev/null
+++ b/src/styles/refresh.css
@@ -0,0 +1,453 @@
+/* Visual refresh: warm palette, lighter surfaces, icon-first cards.
+   Loaded last. Only visual overrides, no layout logic that tests depend on. */
+
+body {
+  background:
+    radial-gradient(circle at 8% 0%, rgb(233 162 59 / 12%), transparent 26rem),
+    radial-gradient(circle at 96% 12%, rgb(156 63 34 / 6%), transparent 24rem),
+    var(--color-background);
+}
+
+/* Headings and eyebrows */
+.page-heading h1 {
+  font-size: var(--text-2xl);
+  font-weight: 700;
+  letter-spacing: -0.02em;
+}
+
+.eyebrow {
+  color: var(--color-brand);
+  letter-spacing: 0.08em;
+  font-weight: 750;
+}
+
+.eyebrow--dark { color: var(--color-brand-deep); }
+
+/* Navigation */
+.main-nav__link::after { background: var(--color-brand); }
+.main-nav__link:hover,
+.main-nav__link.is-active { color: var(--color-brand); }
+.main-nav__link.is-active .icon { color: var(--color-brand); }
+.brand__name span { color: var(--color-lime); }
+
+/* Panels: lighter, one border level */
+.panel {
+  border-color: var(--color-border);
+  box-shadow: var(--shadow-card);
+}
+
+.disclosure > summary .icon { flex: 0 0 auto; color: var(--color-brand); }
+
+/* Primary buttons */
+.button--primary,
+.account-cta {
+  background: var(--color-brand);
+  border-color: var(--color-brand);
+  color: #fff;
+}
+
+.button--primary:hover,
+.account-cta:hover { background: var(--color-brand-deep); }
+
+.status-dot,
+.profile-status i { background: var(--color-green); box-shadow: 0 0 0 3px var(--color-green-soft); }
+
+/* KPI tiles with icon chips */
+.metric-row > div {
+  padding: 14px 16px;
+  border: 1px solid var(--color-border);
+  border-radius: 12px;
+  background: var(--color-surface-2);
+}
+
+.metric-row dt {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 12.5px;
+  font-weight: 600;
+}
+
+.metric-row dd {
+  padding-left: 42px;
+  font-size: 22px;
+  letter-spacing: -0.01em;
+}
+
+.metric-glyph {
+  flex: 0 0 32px;
+  box-sizing: border-box;
+  width: 32px;
+  height: 32px;
+  padding: 7px;
+  border-radius: 50%;
+  background: var(--color-brand-soft);
+  color: var(--color-brand);
+}
+
+.metric-row > div[data-tone="negative"] { border-color: #f3c9d0; }
+.metric-row > div[data-tone="negative"] .metric-glyph { background: #fff; color: var(--color-danger); }
+.metric-row > div[data-tone="positive"] { border-color: #cfe6d7; }
+.metric-row > div[data-tone="positive"] .metric-glyph { background: #fff; color: var(--color-green); }
+
+/* Retirement strip progress: number first, explanation on demand */
+.retirement-income-strip__progress {
+  height: 10px;
+  background: var(--color-track);
+}
+
+.retirement-income-strip__progress span {
+  background: linear-gradient(90deg, var(--color-green), var(--chart-green));
+}
+
+.retirement-income-strip__meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-top: 10px;
