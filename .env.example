# Primeiro acesso pelo Supabase. Ative SQLite e login local no Perfil.
# LOCAL_DB_PATH=.data/aposenta.sqlite
# Configure o Supabase para o primeiro acesso. Node.js 24 ou superior.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-publicavel-anon
APP_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=false
LEGAL_BETA_APPROVED=false
LEGAL_CONTROLLER_NAME=
LEGAL_PRIVACY_CONTACT=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
